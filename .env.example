# =====================================================================
# Variables d'environnement — Gestion des stagiaires
# Copier ce fichier vers .env puis adapter les valeurs :
#     cp .env.example .env
# Le fichier .env NE DOIT JAMAIS être commité (voir .gitignore).
# =====================================================================

# ----- Base de données MySQL -----
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=stagiaires-db
MYSQL_USER=stagiaire_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_PORT=3306

# ----- Backend Spring Boot -----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Niveau des logs de l'aspect AOP (INFO = durée ; DEBUG = + arguments/résultats)
LOG_LEVEL_ASPECT=INFO

# ----- Sécurité (authentification JWT) -----
# OBLIGATOIRE : clé de signature des jetons, 32 caractères minimum.
# Générer avec : openssl rand -base64 48
JWT_SECRET=
# Durée de validité d'une connexion (ex. 8h, 30m)
JWT_DUREE=8h
# Compte administrateur créé au premier démarrage (base sans utilisateur).
# Mot de passe : 8 caractères minimum. À changer ensuite depuis l'application.
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=

# ----- Organisme d'accueil (attestations de stage PDF) -----
ORGANISATION_NOM=Organisme d'accueil
ORGANISATION_VILLE=Casablanca
# Nom du signataire (facultatif : sinon l'attestation est rédigée au nom de la fonction)
ORGANISATION_SIGNATAIRE=
ORGANISATION_FONCTION=Directeur des Ressources Humaines

# ----- Frontend Angular -----
FRONTEND_PORT=4000
# URL publique du backend, utilisée par le navigateur (doit rester joignable côté client)
API_URL=http://localhost:8080
# Hôtes autorisés pour le rendu SSR (liste séparée par des virgules).
# En production, renseigner le(s) domaine(s) public(s) (ex: mon-domaine.fr,www.mon-domaine.fr).
ALLOWED_HOSTS=localhost,127.0.0.1

# ----- CORS -----
# Origines autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
